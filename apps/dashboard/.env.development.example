# OnTime — apps/dashboard — DEVELOPMENT (local)
# Copier : cp apps/dashboard/.env.development.example apps/dashboard/.env.development
# Puis éventuellement : apps/dashboard/.env.development.local pour overrides perso (gitignoré)

# -------------------------- AUTH (Auth.js — credentials) --------------------------

AUTH_SECRET='change-me-run-openssl-rand-base64-32'
# OAuth optionnel (plus tard) :
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_CLIENT_ID=
# AUTH_MICROSOFT_ENTRA_ID_CLIENT_SECRET=

# -------------------------- DATABASE (PostgreSQL local + Prisma) --------------------------

DATABASE_URL=postgresql://postgres:password@localhost:5432/ontime_dev

# -------------------------- BILLING (Stripe TEST) --------------------------

NEXT_PUBLIC_BILLING_PRICE_PRO_MONTH_ID=
NEXT_PUBLIC_BILLING_PRICE_PRO_YEAR_ID=
NEXT_PUBLIC_BILLING_PRICE_LIFETIME_ID=
NEXT_PUBLIC_BILLING_PRICE_ENTERPRISE_MONTH_ID=
NEXT_PUBLIC_BILLING_PRICE_ENTERPRISE_YEAR_ID=
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=

# -------------------------- EMAIL (NodeMailer local — Mailpit) --------------------------

EMAIL_FROM=noreply@localhost
EMAIL_FEEDBACK_INBOX=feedback@localhost
EMAIL_NODEMAILER_URL=smtp://127.0.0.1:1025

# -------------------------- ANALYTICS / MONITORING (Console) --------------------------

NEXT_PUBLIC_ANALYTICS_GA_DISABLE_LOCALHOST_TRACKING=false
NEXT_PUBLIC_ANALYTICS_GA_DISABLE_PAGE_VIEWS_TRACKING=false
NEXT_PUBLIC_ANALYTICS_UMAMI_DISABLE_LOCALHOST_TRACKING=false

# -------------------------- ROUTES (localhost) --------------------------

NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
NEXT_PUBLIC_PUBLIC_API_URL=http://localhost:3002
