# OnTime — apps/dashboard — STAGING (hébergeur / Preview)
# Ne pas committer de secrets. Copier ces clés dans Vercel/Railway/… (env Staging / Preview).
# Base, AUTH_SECRET, Stripe et SMTP = valeurs DÉDIÉES staging (≠ local, ≠ prod).

# -------------------------- AUTH --------------------------

AUTH_SECRET=
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=

# -------------------------- DATABASE (Postgres staging) --------------------------

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ontime_staging

# -------------------------- BILLING (Stripe TEST — compte staging) --------------------------

NEXT_PUBLIC_BILLING_PRICE_PRO_MONTH_ID=
NEXT_PUBLIC_BILLING_PRICE_PRO_YEAR_ID=
NEXT_PUBLIC_BILLING_PRICE_LIFETIME_ID=
NEXT_PUBLIC_BILLING_PRICE_ENTERPRISE_MONTH_ID=
NEXT_PUBLIC_BILLING_PRICE_ENTERPRISE_YEAR_ID=
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=

# -------------------------- EMAIL (SMTP staging) --------------------------

EMAIL_FROM=noreply@staging.example.com
EMAIL_FEEDBACK_INBOX=feedback@staging.example.com
EMAIL_NODEMAILER_URL=

# -------------------------- ANALYTICS / MONITORING --------------------------

NEXT_PUBLIC_ANALYTICS_GA_DISABLE_LOCALHOST_TRACKING=false
NEXT_PUBLIC_ANALYTICS_GA_DISABLE_PAGE_VIEWS_TRACKING=false
NEXT_PUBLIC_ANALYTICS_UMAMI_DISABLE_LOCALHOST_TRACKING=false
# Optionnel staging : Sentry plus tard
# NEXT_PUBLIC_MONITORING_SENTRY_DSN=

# -------------------------- ROUTES (URLs staging) --------------------------

NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.staging.example.com
NEXT_PUBLIC_MARKETING_URL=https://staging.example.com
NEXT_PUBLIC_PUBLIC_API_URL=https://api.staging.example.com
