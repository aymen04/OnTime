# OnTime — apps/dashboard
# Stack MVP (tranchée) : Postgres+Prisma · Auth.js credentials · Stripe · NodeMailer · Analytics/Monitoring Console
# Géocodage : Nominatim (pas de clé). Alternatives commentées en bas.
# Copier : cp apps/dashboard/.env.example apps/dashboard/.env

# -------------------------- AUTH (Auth.js — credentials) --------------------------

AUTH_SECRET='change-me-run-openssl-rand-base64-32'
# OAuth optionnel (plus tard) :
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_CLIENT_ID=
# AUTH_MICROSOFT_ENTRA_ID_CLIENT_SECRET=

# -------------------------- DATABASE (PostgreSQL + Prisma) --------------------------

DATABASE_URL=postgresql://postgres:password@localhost:5432/ontime

# -------------------------- BILLING (Stripe) --------------------------
# Provider actif : packages/billing/src/provider/index.ts → stripe

NEXT_PUBLIC_BILLING_PRICE_PRO_MONTH_ID=
NEXT_PUBLIC_BILLING_PRICE_PRO_YEAR_ID=
NEXT_PUBLIC_BILLING_PRICE_LIFETIME_ID=
NEXT_PUBLIC_BILLING_PRICE_ENTERPRISE_MONTH_ID=
NEXT_PUBLIC_BILLING_PRICE_ENTERPRISE_YEAR_ID=
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=

# -------------------------- EMAIL (NodeMailer / SMTP) --------------------------
# Provider actif : packages/email/src/provider/index.ts → nodemailer
# Local tip : Mailpit/Mailhog → smtp://127.0.0.1:1025

EMAIL_FROM=noreply@localhost
EMAIL_FEEDBACK_INBOX=feedback@localhost
EMAIL_NODEMAILER_URL=smtp://127.0.0.1:1025

# -------------------------- ANALYTICS (Console — défaut) --------------------------
# Provider actif : packages/analytics/src/provider/index.ts → console
# Booléens requis par le schéma env même si Console (ne pas supprimer).

NEXT_PUBLIC_ANALYTICS_GA_DISABLE_LOCALHOST_TRACKING=false
NEXT_PUBLIC_ANALYTICS_GA_DISABLE_PAGE_VIEWS_TRACKING=false
NEXT_PUBLIC_ANALYTICS_UMAMI_DISABLE_LOCALHOST_TRACKING=false

# -------------------------- MONITORING (Console — défaut) --------------------------
# Provider actif : packages/monitoring/src/provider/index.ts → console
# Aucune variable requise.

# -------------------------- ROUTES --------------------------

NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
NEXT_PUBLIC_PUBLIC_API_URL=http://localhost:3002

# =============================================================================
# PLUS TARD (décommenter + basculer le provider dans packages/*/src/provider/index.ts)
# =============================================================================

# --- Analytics : Google Analytics ---
# NEXT_PUBLIC_ANALYTICS_GA_MEASUREMENT_ID=

# --- Analytics : PostHog ---
# NEXT_PUBLIC_ANALYTICS_POSTHOG_KEY=
# NEXT_PUBLIC_ANALYTICS_POSTHOG_HOST=https://us.i.posthog.com

# --- Analytics : Umami ---
# NEXT_PUBLIC_ANALYTICS_UMAMI_HOST=https://cloud.umami.is/script.js
# NEXT_PUBLIC_ANALYTICS_UMAMI_WEBSITE_ID=

# --- Email : Resend / Postmark / SendGrid ---
# EMAIL_RESEND_API_KEY=
# EMAIL_POSTMARK_SERVER_TOKEN=
# EMAIL_SENDGRID_API_KEY=

# --- Monitoring : Sentry ---
# MONITORING_SENTRY_ORG=
# MONITORING_SENTRY_PROJECT=
# MONITORING_SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_MONITORING_SENTRY_DSN=
# SENTRY_SUPPRESS_TURBOPACK_WARNING=1
